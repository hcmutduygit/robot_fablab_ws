<?xml version='1.0'?>

<robot name="reception"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find robot_fablab)/urdf/robot_fablab.gazebo"/>


<link name="base_footprint">
  <visual>
    <geometry>
      <box size="0.001 0.001 0.001"/>
    </geometry>
  </visual>
</link>


  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.025807 0.027971 0.41357" rpy="0 0 0" />
      <mass value="29.924" />
      <inertia ixx="1.0006" ixy="-0.0013232" ixz="0.0065325" iyy="0.70301" iyz="-3.0656E-05" izz="1.3855" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="link_left">
    <inertial>
      <origin xyz="-0.00011936 0.00025083 0.014883" rpy="0 0 0" />
      <mass value="1.0707" />
      <inertia ixx="0.0032566" ixy="1.1489E-08" ixz="-1.3959E-05" iyy="0.0032564" iyz="-9.4568E-09" izz="0.0062144" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="">
        <color rgba="0.59608 0.66667 0.68627 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_left" type="continuous">
    <origin xyz="0.19672 0.3411 0.036748" rpy="1.5708 0 0" />
    <parent link="base_link" />
    <child link="link_left" />
    <axis xyz="0 0 -1" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <link name="link_right">
    <inertial>
      <origin xyz="0.00023152 0.00019816 -0.014882" rpy="0 0 0" />
      <mass value="1.0707" />
      <inertia ixx="0.0032565" ixy="-4.4065E-08" ixz="-1.3949E-05" iyy="0.0032564" iyz="2.7514E-08" izz="0.0062144" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="">
        <color rgba="0.59608 0.66667 0.68627 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_right" type="continuous">
    <origin xyz="0.1933 -0.34091 0.0368" rpy="1.5708 0 0" />
    <parent link="base_link" />
    <child link="link_right" />
    <axis xyz="0 0 -1" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <link name="link_caster">
    <inertial>
      <origin xyz="0.018731 0.021844 -0.00013927" rpy="0 0 0" />
      <mass value="0.37837" />
      <inertia ixx="0.00048693" ixy="-8.3984E-05" ixz="2.0261E-06" iyy="0.00045028" iyz="1.5693E-06" izz="0.00064534" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.038"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_caster" type="continuous">
    <origin xyz="-0.25394 0.00080362 -0.0255" rpy="1.5708 0 0" />
    <parent link="base_link" />
    <child link="link_caster" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <link name="link_lidar">
    <inertial>
      <origin xyz="-0.002487 1.09E-05 -0.024095" rpy="0 0 0" />
      <mass value="0.035081" />
      <inertia ixx="1.9431E-05" ixy="7.3718E-10" ixz="4.0724E-08" iyy="1.932E-05" iyz="-1.091E-09" izz="3.7018E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes/link_lidar.STL" />
      </geometry>
      <material name="">
        <color rgba="0 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes/link_lidar.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_lidar" type="fixed">
    <origin xyz="0.011534 0.010999 0.55646" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link_lidar" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="link_camera">
    <inertial>
      <origin xyz="-0.016107 4.0071E-05 -0.00053431" rpy="0 0 0" />
      <mass value="0.15226" />
      <inertia ixx="0.0003084" ixy="-1.3455E-06" ixz="-4.4401E-08" iyy="2.2766E-05" iyz="9.3764E-09" izz="0.00031076" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes/link_camera.STL" />
      </geometry>
      <material name="">
        <color rgba="0.27059 0.27059 0.27059 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_fablab/meshes/link_camera.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="joint_camera" type="fixed">
    <origin xyz="-0.11803 0.012232 1.3955" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link_camera" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>    
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- transmission -->
  <transmission name="right_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <actuator name="motor_right_wheel">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
    <joint name="joint_right">
      <hardwareInterface>VelocityJointInterface</hardwareInterface>
    </joint>
  </transmission>

  <transmission name="left_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <actuator name="motor_left_wheel">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
    <joint name="joint_left">
      <hardwareInterface>VelocityJointInterface</hardwareInterface>
    </joint>
  </transmission>
  
</robot>
