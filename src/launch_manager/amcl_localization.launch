<launch>
  <!-- Lidar driver -->
  <include file="$(find rplidar_ros)/launch/rplidar_s2.launch" />

  <!-- RViz -->
  <arg name="rvizconfig" default="$(find rviz)/rviz.rviz"/>
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rvizconfig)"/>

  <!-- Load map (yaml file, không dùng .pbstream) -->
  <arg name="map_file" default="$(find robot_fablab)/maps/map_fablab.yaml" />
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />

  <!-- CAN node: đọc dữ liệu từ CAN/IMU -->
  <node pkg="cmd_vel" type="can_node" name="can_node" output="screen"/>

  <!-- Odom publisher: chuyển /pose_robot thành /odom -->
  <node pkg="odom_publisher" type="odom_publisher" name="odom_publisher" output="screen"/>

  <!-- AMCL for localization -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    
    <!-- Parameters -->
    <param name="odom_model_type" value="diff"/>
    <param name="use_map_topic" value="false"/>
    <param name="update_min_d" value="0.2"/>
    <param name="update_min_a" value="0.2"/>
    <param name="min_particles" value="100"/>
    <param name="max_particles" value="5000"/>
    <param name="laser_max_range" value="12.0"/>
    <param name="laser_min_range" value="0.1"/>
    <param name="gui_publish_rate" value="10.0"/>
    
    <!-- Frame setup -->
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_footprint"/>
    <param name="global_frame_id" value="map"/>
  </node>

  <!-- Static TF: base_footprint -> laser -->
  <node pkg="tf" type="static_transform_publisher" name="basefootprint_to_laser"
        args="0 0 0 0 0 0 base_footprint laser 50" />
</launch>
